# Kopieer dit bestand naar .env.docker en vul APP_KEY en REGISTRATION_CODE in.
# .env.docker staat in .gitignore en hoort nooit in de repo te belanden.
#
#   cp .env.docker.example .env.docker
#   php artisan key:generate --show     # plak de uitvoer bij APP_KEY

APP_NAME=Vakantie
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Met https en zonder slash erachter, en gelijk aan DOMAIN in .env.proxy.
# Laat je hier http:// staan, dan zet Laravel dat ook in de links die het in
# mails en redirects genereert.
APP_URL=https://vakantie.voorbeeld.nl

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Naar stderr, zodat alles in `docker compose logs` terechtkomt en er niets
# ongemerkt volloopt in de container.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Het pad binnen de container; hier hangt het vakantie-db volume.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/sqlite/database.sqlite

# Verplicht invullen. Leeg betekent dat iedereen die /register vindt een
# account kan aanmaken.
REGISTRATION_CODE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Het sessiecookie wordt alleen over https verstuurd. Kan aan omdat de proxy
# elk http-verzoek doorstuurt naar https. Zet dit op false als je (tijdelijk)
# zonder proxy draait, anders kun je niet inloggen: de browser stuurt het
# cookie dan nooit terug en je blijft op het loginscherm hangen.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# De gegevens van je mailserver; in Plesk te vinden onder E-mail bij het
# postvak zelf. MAIL_USERNAME is het volledige adres, niet alleen het stukje
# voor de apenstaart.
#
# MAIL_HOST moet de naam zijn die op het TLS-certificaat van de mailserver
# staat, en dat is meestal niet je eigen domeinnaam. Vult je hoster
# `webmail.jouwdomein.nl` in maar heet de machine `mwp67.cloud86-host.io`,
# dan breekt de verbinding af met:
#
#   Peer certificate CN=`...' did not match expected CN=`...'
#
# Gebruik dan de naam uit die melding. Het certificaat uitzetten kan ook,
# maar dan gooi je precies de controle weg die je hier beschermt.
#
# MAIL_SCHEME bepaalt de versleuteling, en hoort bij de poort:
#   smtps + poort 465  -> versleuteld vanaf de eerste byte
#   smtp  + poort 587  -> begint onversleuteld en schakelt over (STARTTLS)
# Weet je het niet, probeer dan 587 met smtp; dat is tegenwoordig het meest
# gebruikelijk.
MAIL_MAILER=smtp
MAIL_HOST=mail.voorbeeld.nl
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=noreply@voorbeeld.nl
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@voorbeeld.nl
# Letterlijk uitschrijven: compose geeft env_file-waarden door zoals ze er
# staan, dus "${APP_NAME}" zou hier niet ingevuld worden.
MAIL_FROM_NAME=Vakantie

# Draai je zonder mailserver, zet MAIL_MAILER dan op `log`. Let op dat de mail
# dan pas zichtbaar is als LOG_LEVEL op `debug` staat: de log-mailer schrijft
# op debug-niveau en wordt bij `warning` weggefilterd.
