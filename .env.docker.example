# Kopieer dit bestand naar .env.docker en vul APP_KEY en REGISTRATION_CODE in.
# .env.docker staat in .gitignore en hoort nooit in de repo te belanden.
#
#   cp .env.docker.example .env.docker
#   php artisan key:generate --show     # plak de uitvoer bij APP_KEY

APP_NAME=Vakantie
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.2.100

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Naar stderr, zodat alles in `docker compose logs` terechtkomt en er niets
# ongemerkt volloopt in de container.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Het pad binnen de container; hier hangt het vakantie-db volume.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/sqlite/database.sqlite

# Verplicht invullen. Leeg betekent dat iedereen die /register vindt een
# account kan aanmaken.
REGISTRATION_CODE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Op true zetten zodra er HTTPS voor de container staat.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Zonder echte SMTP doet 'wachtwoord vergeten' niets; de mail verdwijnt
# in de log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
# Letterlijk uitschrijven: compose geeft env_file-waarden door zoals ze er
# staan, dus "${APP_NAME}" zou hier niet ingevuld worden.
MAIL_FROM_NAME=Vakantie
