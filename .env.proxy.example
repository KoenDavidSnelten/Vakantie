# Kopieer dit bestand naar .env.proxy en vul het in.
# .env.proxy staat in .gitignore.
#
#   cp .env.proxy.example .env.proxy

# De domeinnaam die naar de Pi wijst. Zonder https:// en zonder slash erachter.
# Er moet een A-record bestaan dat deze naam naar het publieke IP van je
# aansluiting wijst, anders kan Let's Encrypt niets verifieren.
DOMAIN=vakantie.voorbeeld.nl

# Hier mailt Let's Encrypt naartoe als een verlenging niet gelukt is en het
# certificaat bijna verloopt. Gebruik een adres dat je echt leest: dit is de
# enige waarschuwing die je krijgt voordat de site onbereikbaar wordt.
LETSENCRYPT_EMAIL=jij@voorbeeld.nl
