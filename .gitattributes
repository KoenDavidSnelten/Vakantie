* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Moeten LF houden: met CRLF weigeren de container en de Pi de shebang uit te
# voeren.
docker/entrypoint.sh text eol=lf
docker/init-letsencrypt.sh text eol=lf
docker/renew-cert.sh text eol=lf
