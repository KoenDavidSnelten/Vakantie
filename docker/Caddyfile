# Caddy doet twee dingen tegelijk: hij handelt https af en hij haalt de
# certificaten op. Dat tweede kan hij zelf, zonder aparte container en zonder
# cronjob, omdat hij de controle van Let's Encrypt afhandelt op de verbinding
# die hij toch al openhoudt.
#
# De waarden tussen {$...} komen uit .env.proxy.

# Alle drie de sites hieronder krijgen hun certificaat op dezelfde manier.
# Een snippet scheelt het drie keer uitschrijven.
(letsencrypt) {
	tls {
		issuer acme {
			dir {$ACME_CA}
			email {$LETSENCRYPT_EMAIL}

			# De gebruikelijke controle loopt over poort 80 en die blokkeert de
			# provider. Uitzetten dus, dan gebruikt Caddy tls-alpn-01 en gaat
			# alles over 443.
			disable_http_challenge
		}
	}
}

# De vakantieplanner.
{$DOMAIN} {
	import letsencrypt

	# De app comprimeert zelf niets; dat gebeurt hier.
	encode gzip

	# Caddy zet X-Forwarded-For, -Proto en -Host er vanzelf bij. Laravel leest
	# die via trustProxies in bootstrap/app.php en weet daardoor dat het
	# oorspronkelijke verzoek over https binnenkwam.
	reverse_proxy app:80

	# Gelijk aan client_max_body_size in docker/nginx.conf.
	request_body {
		max_size 2MB
	}
}

# Het kale domein: losse bestanden uit site/, geen Laravel.
{$SITE_DOMAIN} {
	import letsencrypt
	encode gzip
	root * /srv/site
	file_server
}

# www stuurt door naar het kale domein, zodat er maar één adres in omloop is.
www.{$SITE_DOMAIN} {
	import letsencrypt
	redir https://{$SITE_DOMAIN}{uri} permanent
}
